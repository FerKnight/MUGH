<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>MUGH</title>
  <link rel="manifest" href="manifest.json">
  <meta name="theme-color" content="#111827">
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0; min-height: 100vh; background: #0b1120; color: #e5e7eb;
      font-family: system-ui, sans-serif; display: grid; place-items: center; padding: 20px;
    }
    .card {
      width: 100%; max-width: 480px; background: #111827; border: 1px solid #1f2937;
      border-radius: 18px; padding: 24px; text-align: center;
    }
    h1 { margin: 0 0 6px; font-size: 34px; letter-spacing: 3px; }
    p { margin: 0 0 20px; color: #9ca3af; }
    button {
      width: 100%; padding: 16px; border: 0; border-radius: 12px; font-size: 17px;
      font-weight: 700; background: #22c55e; color: #052e16; cursor: pointer;
    }
    button:active { transform: scale(.98); }
    #files { margin-top: 18px; text-align: left; }
    .file {
      display: flex; justify-content: space-between; gap: 10px; align-items: center;
      background: #0f172a; border: 1px solid #1f2937; padding: 10px 12px;
      border-radius: 10px; margin-bottom: 8px; font-size: 14px; word-break: break-all;
    }
    .small { font-size: 12px; color: #6b7280; }
    a { color: #22c55e; text-decoration: none; font-weight: 700; }
  </style>
</head>
<body>
  <main class="card">
    <h1>MUGH</h1>
    <p>Selecciona y guarda archivos de cualquier tipo</p>

    <input id="picker" type="file" multiple style="display:none">
    <button id="open">Seleccionar archivos</button>

    <div id="files"></div>
  </main>

  <script>
    const picker = document.getElementById('picker');
    const openBtn = document.getElementById('open');
    const filesBox = document.getElementById('files');

    openBtn.addEventListener('click', () => picker.click());

    picker.addEventListener('change', async () => {
      filesBox.innerHTML = '';

      for (const file of picker.files) {
        const row = document.createElement('div');
        row.className = 'file';

        const info = document.createElement('div');
        info.innerHTML = `<strong>${file.name}</strong><br>
          <span class="small">${(file.size / 1024).toFixed(1)} KB</span>`;

        const url = URL.createObjectURL(file);
        const link = document.createElement('a');
        link.href = url;
        link.download = file.name;
        link.textContent = 'Guardar';

        row.append(info, link);
        filesBox.append(row);
      }

      picker.value = '';
    });

    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.register('sw.js');
    }
  </script>
</body>
</html>
